# ── 依赖目录（体积大且平台相关，绝不入库）──
node_modules/
backend/venv/
venv/
env/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── 构建产物 ──
dist/
dist-ssr/
*.local

# ── 本地数据库（运行时生成，启动会自动重建）──
substation.db
substation.db-journal
*.sqlite
*.sqlite3

# ── 环境变量 / 密钥 ──
.env
.env.*
!.env.example

# ── 编辑器与系统 ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── 日志 ──
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
